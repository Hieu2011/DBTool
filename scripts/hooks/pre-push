#!/bin/sh
# Releases DbStudio to the update folder when a push to main changes the app's version.
# Turned on per clone with scripts\install-hooks.ps1. DBSTUDIO_SKIP_DEPLOY=1 git push skips it once.
# A failed release stops the push, so GitHub and the update folder never disagree.

PROJECT=src/DbStudio.Host/DbStudio.Host.csproj
version_of() { git show "$1:$PROJECT" 2>/dev/null | sed -n 's:.*<Version>\([^<]*\)</Version>.*:\1:p' | head -n 1; }

[ "$DBSTUDIO_SKIP_DEPLOY" = "1" ] && exit 0

while read -r strLocalRef strLocalSha strRemoteRef strRemoteSha; do
  [ "$strRemoteRef" = "refs/heads/main" ] || continue
  case "$strLocalSha" in *[!0]*) ;; *) continue ;; esac            # deleting the branch

  strNew=$(version_of "$strLocalSha")
  strOld=""
  case "$strRemoteSha" in *[!0]*) strOld=$(version_of "$strRemoteSha") ;; esac
  [ -n "$strNew" ] && [ "$strNew" != "$strOld" ] || continue

  echo "pre-push: version ${strOld:-none} -> $strNew, releasing to the update folder..."

  # The build reads the working tree: it has to be exactly the commit being pushed.
  if [ "$(git rev-parse HEAD)" != "$strLocalSha" ] || [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "pre-push: commit or stash your changes first; the release is built from the files on disk." >&2
    exit 1
  fi
  if ! grep -q "^## $strNew\b" CHANGELOG.md 2>/dev/null; then
    echo "pre-push: CHANGELOG.md has no '## $strNew' entry. Add it (its lines become the update notes) and commit." >&2
    exit 1
  fi

  powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1 -IfNewer </dev/null || {
    echo "pre-push: the release failed, nothing was pushed." >&2
    exit 1
  }
done
exit 0
