<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DbStudio</AssemblyName>
    <RootNamespace>DbStudio.Host</RootNamespace>
    <!-- lets the project build on Linux/macOS CI too; it still only runs on Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- wwwroot is embedded so the published exe is a single file -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- WebView2 ships a WPF assembly too; its WindowsBase version note is harmless here -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Help > Check for updates compares this with version.json of the update folder: raise it for every release -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbStudio.Providers\DbStudio.Providers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>
</Project>
